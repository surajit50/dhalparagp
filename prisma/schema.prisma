  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workBillAbstractId String           @db.ObjectId
  workBillAbstract   WorkBillAbstract @relation(fields: [workBillAbstractId], references: [id], onDelete: Cascade)

  // Bill details
  billType          String    @default("1st & Final Bill")
  billPaymentDate   DateTime?
  eGramVoucher      String?
  eGramVoucherDate  DateTime?
  gpmsVoucherNumber String?
  gpmsVoucherDate   DateTime?

  // Gross amount (from bill abstract actual value)
  grossBillAmount Float

  // Deductions - stored directly without relations
  lessIncomeTaxPercentage Float @default(1.00)
  lessIncomeTaxAmount     Float @default(0)

  lessGstTdsPercentage Float @default(0.00)
  lessGstTdsAmount     Float @default(0)
  lessCgstAmount       Float @default(0)
  lessSgstAmount       Float @default(0)

  lessLabourWelfareCessPercentage Float @default(1.00)
  lessLabourWelfareCessAmount     Float @default(0)

  lessSecurityDepositPercentage Float @default(10.00)
  lessSecurityDepositAmount     Float @default(0)

  lessRoyaltyAmount    Float @default(0)
  otherDeductionAmount Float @default(0)

  // Total and net
  totalDeduction   Float
  netPayableAmount Float

  // Status
  isFinalBill Boolean   @default(false)
  isVerified  Boolean   @default(false)
  verifiedBy  String?
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, workBillAbstractId])
  @@map("work_bill_deductions")
