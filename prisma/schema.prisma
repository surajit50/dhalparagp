// ===================================================
// --- NREGA / VB-GRAMG WORK & CERTIFICATE SYSTEM ---
// ===================================================

enum NregaWorkStatus {
  DRAFT
  APPROVED
  ONGOING
  COMPLETED
}

enum NregaCertificateStatus {
  DRAFT
  COMPLETED
  PRINTED
  NOT_APPLICABLE
}

enum VerificationStatus {
  YES
  NO
  NA
  PENDING
}

model NregaWork {
  id                       String          @id @default(auto()) @map("_id") @db.ObjectId
  workId                   String          @unique // e.g. NREGA-2526-001

  // Basic Information
  financialYear            String
  scheme                   String          @default("VB-GRAMG")
  workName                 String
  natureOfWork             String?
  masterCategory           String?
  subCategory              String?
  permissibleWorkSlNo      String?
  permissibleWorkDesc      String?

  // Location
  gramPanchayat            String
  gramSansadName           String?
  gramSansadNumber         String?
  block                    String
  district                 String
  mouza                    String?
  jlNumber                 String?
  plotNumber               String?
  latitude                 Float?
  longitude                Float?
  worksiteType             String?
  landArea                 String?

  // Financial
  estimatedCost            Float           @default(0)
  wageComponent            Float           @default(0)
  materialComponent        Float           @default(0)
  wageMaterialRatio        String?         // e.g. "60:40"
  vbGramgShare             Float?          @default(0)
  convergenceDeptShare     Float?          @default(0)
  totalEstimatedCost       Float           @default(0)

  // Beneficiary
  beneficiaryType          String?         // "Individual" | "Community"
  beneficiaryName          String?
  jobCardNumber            String?
  beneficiaryCategory      String?

  // Administrative
  gramSabhaApprovalDate    DateTime?
  adminApprovalNumber      String?
  adminApprovalDate        DateTime?
  technicalSanctionNumber  String?
  technicalSanctionDate    DateTime?
  dprNumber                String?
  dprDate                  DateTime?

  // Convergence
  convergingDepartment     String?
  convergingScheme         String?
  convergenceCategory      String?
  technicalKnowledgeProvided String?
  nocReceived              String?         // "Yes" | "No" | "N/A"
  nocMemoNumber            String?
  nocDate                  DateTime?

  // Other
  remarks                  String?
  workStatus               NregaWorkStatus @default(DRAFT)

  // Relations
  certificates             NregaCertificate[]
  verifications            NregaCertificateVerification[]
  auditLogs                NregaAuditLog[]

  // Optional link to existing action plan
  actionPlanId             String?         @db.ObjectId

  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt

  @@index([financialYear])
  @@index([workStatus])
  @@index([gramPanchayat])
  @@map("nrega_works")
}

model NregaCertificate {
  id                   String                 @id @default(auto()) @map("_id") @db.ObjectId
  workId               String                 @db.ObjectId
  work                 NregaWork              @relation(fields: [workId], references: [id], onDelete: Cascade)

  certificateNumber    Int                    // 2-8
  certificateName      String
  status               NregaCertificateStatus @default(DRAFT)
  certificationText    String?                // Editable certification paragraph
  signatureDesignation String?
  signatureBlock       String?
  signatureDate        DateTime?

  generatedAt          DateTime?
  printedAt            DateTime?

  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@unique([workId, certificateNumber])
  @@index([certificateNumber])
  @@map("nrega_certificates")
}

model NregaCertificateVerification {
  id                String             @id @default(auto()) @map("_id") @db.ObjectId
  workId            String             @db.ObjectId
  work              NregaWork          @relation(fields: [workId], references: [id], onDelete: Cascade)

  certificateNumber Int                // Which certificate (2-8)
  parameter         String             // Verification question text
  parameterKey      String             // Machine-readable key
  status            VerificationStatus @default(PENDING)
  remarks           String?
  verifiedBy        String?
  verifiedDate      DateTime?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([workId, certificateNumber])
  @@map("nrega_certificate_verifications")
}

model NregaCertificateTemplate {
  id                   String   @id @default(auto()) @map("_id") @db.ObjectId
  certificateNumber    Int      @unique // 2-8
  certificateName      String
  title                String
  subtitle             String?
  verificationFields   Json     // Array of { key, label, defaultStatus }
  certificationText    String   // Default certification paragraph template
  signatureDesignation String   @default("Block Development Officer")
  active               Boolean  @default(true)
  version              Int      @default(1)
  language             String   @default("en")

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("nrega_certificate_templates")
}

model NregaSignatureSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  designation String
  name        String?
  block       String?
  isDefault   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("nrega_signature_settings")
}

model NregaMasterData {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      String   // "FINANCIAL_YEAR", "CATEGORY", "SUB_CATEGORY", etc.
  value     String
  label     String
  parentId  String?  @db.ObjectId // For sub-categories
  sortOrder Int      @default(0)
  active    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@map("nrega_master_data")
}

model NregaAuditLog {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  action            String     // WORK_CREATED, WORK_EDITED, CERT_GENERATED, etc.
  workId            String?    @db.ObjectId
  work              NregaWork? @relation(fields: [workId], references: [id])
  certificateNumber Int?
  userId            String?
  userName          String?
  details           String?

  createdAt         DateTime   @default(now())

  @@index([workId])
  @@index([action])
  @@map("nrega_audit_logs")
}
