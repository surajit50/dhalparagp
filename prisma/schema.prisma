  applicantAddress                String
  applicantVillage                String?
  applicantPostOffice             String?
  applicantBlock                  String?
  applicantDistrict               String?
  applicantState                  String?
  officeCode                      String?
  jurisdictionCode                String?
  linkageType                     String?
  linkageCategory                 String?
  linkageReason                   String?
  linkedEntityName                String?
  linkedEntityAddress             String?
  documents                       String[]
  submittedAt                     DateTime?
  validatedAt                     DateTime?
  ownershipVerifiedAt             DateTime?
  approvedAt                      DateTime?
  rejectedReason                  String?
  rejectedBy                      String?
  createdAt                       DateTime                        @default(now())
  updatedAt                       DateTime                        @updatedAt
  createdBy                       User?                           @relation(fields: [createdById], references: [id])
  createdById                     String?                         @db.ObjectId
  verification                    LinkageDocumentValidation?
  ownership                       LinkageOwnershipVerification?
  certificate                     LinkageCertificate?
  renewals                        LinkageRenewal[]
  disputes                        LinkageDispute[]
  linkageApplicationBeneficiaries LinkageApplicationBeneficiary[]

  @@index([status, createdAt])
  @@index([officeCode, status])
  @@index([applicantNationalId])
  @@index([applicantName])
  @@index([linkedEntityName])
}

model LinkageDocumentValidation {
  id                String                  @id @default(auto()) @map("_id") @db.ObjectId
  applicationId     String                  @unique @db.ObjectId
  application       LinkageApplication      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  validatorName     String
  validatorId       String?
  validatorRole     String?
  officeCode        String?
  validationDate    DateTime
  findings          String?
  rejectionReason   String?
  status            LinkageValidationStatus @default(PENDING)
  documentsVerified String[]                @default([])
  checklist         Json?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
}

model LinkageOwnershipVerification {
  id                 String                 @id @default(auto()) @map("_id") @db.ObjectId
  applicationId      String                 @unique @db.ObjectId
  application        LinkageApplication     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  officerName        String
  officerId          String?
  officerRole        String?
  officeCode         String?
  verificationDate   DateTime
  remarks            String?
  rejectionReason    String?
  ownershipConfirmed Boolean                @default(false)
  status             LinkageOwnershipStatus @default(PENDING)
  verifiedBy         String?
  proofDocuments     String[]               @default([])
  processedDate      DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
}

model LinkageCertificate {
  id                String               @id @default(auto()) @map("_id") @db.ObjectId
  applicationId     String               @unique @db.ObjectId
  application       LinkageApplication   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  certificateNo     String               @unique
  referenceNo       String?
  memoNo            String?
  certificateType   String?
  certificateBody   String?
  issueDate         DateTime
  expiryDate        DateTime?
  issuingOfficeCode String?
  issuingAuthority  String?
  conditions        String[]
  signedBy          String
  signedDesignation String
  digitalSignHash   String?
  pdfUrl            String?
  pdfKey            String?
  verificationUrl   String?
  qrCodeData        String?
  gpProfileId       String?              @db.ObjectId
  gpProfile         GPProfile?           @relation(fields: [gpProfileId], references: [id])
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  linkageRenewals   LinkageRenewal[]
  linkageDisputes   LinkageDispute[]
  beneficiaries     LinkageBeneficiary[]

  @@index([issueDate])
}

model LinkageRenewal {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  certificateId        String              @db.ObjectId
  certificate          LinkageCertificate  @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  renewalDate          DateTime
  newExpiryDate        DateTime?
  renewalReason        String
  renewalOrderNo       String?
  renewalRemarks       String?
  status               RenewalStatus       @default(PENDING)
  processedBy          String?
  processedDate        DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  linkageApplication   LinkageApplication? @relation(fields: [linkageApplicationId], references: [id])
  linkageApplicationId String?             @db.ObjectId

  @@index([certificateId])
  @@index([status])
}

model LinkageDispute {
  id                   String              @id @default(auto()) @map("_id") @db.ObjectId
  certificateId        String              @db.ObjectId
  certificate          LinkageCertificate  @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  raisedByName         String
  raisedByPhone        String
  grievanceNo          String?
  reason               String
  status               DisputeStatus       @default(PENDING)
  assignedTo           String?
  assignedRole         String?
  hearingDate          DateTime?
  resolutionNotes      String?
  disposalOrderNo      String?
  resolvedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  linkageApplication   LinkageApplication? @relation(fields: [linkageApplicationId], references: [id])
  linkageApplicationId String?             @db.ObjectId

  @@index([certificateId])
  @@index([status])
}

model LinkageBeneficiary {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  relation String

  gender        Gender?
  livingStatus  LivingStatus?
  parentId      String?              @db.ObjectId
  parent        LinkageBeneficiary?  @relation("LinkageBeneficiaryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children      LinkageBeneficiary[] @relation("LinkageBeneficiaryHierarchy")
  certificateId String               @db.ObjectId
  certificate   LinkageCertificate   @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([certificateId])
}

model LinkageApplicationBeneficiary {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  name     String
  relation String

  gender        Gender?
  livingStatus  LivingStatus?
  parentId      String?                         @db.ObjectId
  parent        LinkageApplicationBeneficiary?  @relation("LinkageApplicationBeneficiaryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children      LinkageApplicationBeneficiary[] @relation("LinkageApplicationBeneficiaryHierarchy")
  applicationId String                          @db.ObjectId
  application   LinkageApplication              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt

  @@index([applicationId])
}



model Holiday {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  date        DateTime
  description String?

  @@unique([date, name]) // ✅ allows multiple holidays per day
  @@map("holidays")
}
model SamabyathiApplication {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  applicationNumber String?  @unique
  applicantName     String
  mobileNumber      String
  villageName       String
  deceasedName      String
  relation          String
  dateOfDeath       DateTime
  voterId           String?
  aadhaarNumber     String?

  status         String @default("PENDING")
  sanctionAmount Float?

  userId String? @db.ObjectId
  user   User?   @relation(fields: [userId], references: [id])

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  musterRolls MusterRoll[]
}

model SamabyathiCounter {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  year       String   @unique
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model Allotment {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  amount       Float
  remaining    Float
  receivedDate DateTime

  createdAt DateTime @default(now())
}

model MusterRoll {
  id            String                @id @default(auto()) @map("_id") @db.ObjectId
  applicationId String                @db.ObjectId
  application   SamabyathiApplication @relation(fields: [applicationId], references: [id])

  musterRollNo String?

  allottedAmount Float
  paymentStatus  String @default("PENDING")

  createdAt DateTime @default(now())
}
